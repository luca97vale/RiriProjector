<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- The shell helper hands its binder here (ADR-014). INTERACT_ACROSS_USERS_FULL is held by
             shell and system only; HelperProvider also accepts only uid 0 or 2000. -->
        <provider
            android:name="dev.ririprojector.helper.HelperProvider"
            android:authorities="${applicationId}.helper"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
